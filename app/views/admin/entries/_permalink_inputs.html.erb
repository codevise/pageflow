<%= form.input(:permalink,
               as: :pageflow_permalink,
               base_url: entry.site.canonical_entry_url_prefix.presence ||
                         pretty_site_url(entry.site),
               site: entry.site,
               only_root: entry.permalink&.allow_root_path,
               slug_placeholder: permalink_slug_placeholder(
                 entry,
                 form.object,
                 except: local_assigns.fetch(:except_permalink_id, form.object.id)
               ),
               hint: entry.new_record? ? nil : t('pageflow.admin.entries.permalink_hint'))%>

<% if entry.permalink&.allow_root_path %>
  <%= hidden_field_tag(:at, 'root') %>
<% end %>
